# Local-only configuration template. Copy to .env; never commit that file.
# PostgreSQL is selected when this is set; leave blank for local SQLite.
INCIDENT_LENS_ENV=local
INCIDENT_LENS_API_ORIGIN=http://localhost:8000
INCIDENT_LENS_DATABASE_URL=
INCIDENT_LENS_SQLITE_PATH=/tmp/incident-lens-phase1.sqlite3
INCIDENT_LENS_OBJECT_STORE_BUCKET=
INCIDENT_LENS_PROVIDER_API_KEY=
# Optional owned-app connector; values stay empty by default. See the live evidence note.
INCIDENT_LENS_CONNECTOR_BASE_URL=
INCIDENT_LENS_CONNECTOR_ALLOWED_HOSTS=
INCIDENT_LENS_CONNECTOR_PATH=
INCIDENT_LENS_CONNECTOR_SOURCE_ID=owned-maintained-app
INCIDENT_LENS_CONNECTOR_SOURCE_VERSION=configured
INCIDENT_LENS_CONNECTOR_ALLOW_HTTP=
# Compose-only local database values; replace the placeholder in your ignored .env.
POSTGRES_DB=incident_lens
POSTGRES_USER=incident_lens
POSTGRES_PASSWORD=replace-with-a-local-only-password
